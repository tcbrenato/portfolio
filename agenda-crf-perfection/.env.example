# ------------------------------------------------------------
#  Agenda CRF Perfection – variables d'environnement
#  Copiez ce fichier en ".env" (même dossier) puis complétez.
#  Valeurs disponibles dans Supabase : Project Settings > API
# ------------------------------------------------------------

# URL du projet Supabase (ex. https://abcdefghijkl.supabase.co)
VITE_SUPABASE_URL=https://VOTRE-PROJET.supabase.co

# Clé publique "anon" / "publishable" (JAMAIS la clé service_role ici)
VITE_SUPABASE_ANON_KEY=VOTRE_CLE_ANON_PUBLIQUE

# Rappels (notifications) : architecture prête mais désactivée
VITE_NOTIFICATIONS_ACTIVES=false
